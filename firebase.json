{
  "firestore": {
    "database": "(default)",
    "location": "asia-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "js/openrouter-config.js",
      "tests/**",
      "test-results/**",
      "playwright-report/**",
      "playwright.config.js",
      "package.json",
      "package-lock.json",
      "skills-lock.json"
    ]
  }
}
